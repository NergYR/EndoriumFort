# ─── EndoriumFort local development environment ───────────────────────────
# Copy values into your shell or a local .env file depending on your workflow.
# This profile is designed for:
# - backend on http://localhost:8080
# - frontend Vite dev server on http://localhost:5173

# Backend listen port
ENDORIUMFORT_PORT=8080

# Session / auth runtime
ENDORIUMFORT_TOKEN_TTL_SECONDS=3600
ENDORIUMFORT_WEBAUTHN_CHALLENGE_TTL_SECONDS=180

# WebAuthn dev profile
# Use localhost for browser passkeys during Vite development.
ENDORIUMFORT_WEBAUTHN_RP_ID=localhost
ENDORIUMFORT_WEBAUTHN_ORIGIN=http://localhost:5173

# Relay control-plane
# Leave empty to keep enrollment fail-closed during local dev.
ENDORIUMFORT_RELAY_ENROLL_SECRET=
ENDORIUMFORT_RELAY_CERT_REQUIRED=true
ENDORIUMFORT_RELAY_CERT_TTL_SECONDS=2592000
ENDORIUMFORT_RELAY_ENROLL_TOKEN_TTL_SECONDS=600
ENDORIUMFORT_RELAY_TOKEN_TTL_SECONDS=86400
ENDORIUMFORT_RELAY_HEARTBEAT_STALE_SECONDS=90
